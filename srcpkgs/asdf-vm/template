post_install() {
	# Install completions
	vinstall internal/completions/asdf.bash 644 usr/share/bash-completion/completions asdf
	vinstall internal/completions/asdf.zsh 644 usr/share/zsh/site-functions _asdf
	vinstall internal/completions/asdf.fish 644 usr/share/fish/vendor_completions.d asdf.fish

	vlicense LICENSE
}
